<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Post</title>
</head>

<body>
    <h1>New-Post</h1>
    <form method="post" action="/ig">
        <input placeholder="enter username" name="user" type="text">
        <br><br>
        <input placeholder="paste image url" name="image" type="text">
        <br><br>
        <textarea rows="10" cols="35" name="caption" placeholder="write a caption..."></textarea>
        <button>Submit post</button>
    </form>
</body>

</html>